{
  "schema_version": 1,
  "id": "antigravity",
  "display_name": "Google Antigravity",
  "cli": {
    "commands": ["antigravity", "agy"],
    "auth_hints": [".config/antigravity"]
  },
  "cliproxy": {
    "provider": "antigravity",
    "login_flag": "--antigravity-login",
    "auth_file_prefixes": ["antigravity-"]
  },
  "models": [
    {
      "key": "gemini-flash-primary",
      "candidates": ["gemini-3.6-flash", "gemini-3.6-flash-high", "gemini-3.5-flash"],
      "patterns": ["^gemini-[0-9.]+-flash(?:-high)?$"],
      "limits_by_model": {
        "gemini-3.6-flash": {
          "maxInputTokens": 1048576,
          "maxOutputTokens": 65536,
          "sources": {
            "maxInputTokens": "https://ai.google.dev/gemini-api/docs/models/gemini-3.6-flash",
            "maxOutputTokens": "https://ai.google.dev/gemini-api/docs/models/gemini-3.6-flash"
          }
        },
        "gemini-3.6-flash-high": {
          "maxInputTokens": 1048576,
          "maxOutputTokens": 65536,
          "sources": {
            "maxInputTokens": "https://ai.google.dev/gemini-api/docs/models/gemini-3.6-flash",
            "maxOutputTokens": "https://ai.google.dev/gemini-api/docs/models/gemini-3.6-flash"
          }
        },
        "gemini-3.5-flash": {
          "maxInputTokens": 1048576,
          "maxOutputTokens": 65536,
          "sources": {
            "maxInputTokens": "https://ai.google.dev/gemini-api/docs/models/gemini-3.5-flash",
            "maxOutputTokens": "https://ai.google.dev/gemini-api/docs/models/gemini-3.5-flash"
          }
        }
      },
      "workbuddy": {
        "supportsToolCall": true,
        "supportsImages": true,
        "supportsReasoning": true,
        "useCustomProtocol": true,
        "onlyReasoning": true,
        "reasoning": {
          "defaultEffort": "high",
          "supportedEfforts": ["high"],
          "canDisableThinking": false
        }
      }
    }
  ]
}
