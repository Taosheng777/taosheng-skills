{
  "schema_version": 1,
  "id": "codex",
  "display_name": "OpenAI Codex",
  "cli": {
    "commands": ["codex"],
    "auth_hints": [".codex/auth.json"]
  },
  "cliproxy": {
    "provider": "codex",
    "login_flag": "--codex-login",
    "auth_file_prefixes": ["codex-"]
  },
  "model_catalogs": [
    {
      "path": ".codex/cliproxyapi-catalog.json",
      "format": "json",
      "id_fields": ["slug", "id"],
      "input_fields": ["max_context_window", "context_window"],
      "output_fields": ["max_output_tokens"]
    },
    {
      "path": ".codex/opencodex-catalog.json",
      "format": "json",
      "id_fields": ["slug", "id"],
      "input_fields": ["max_context_window", "context_window"],
      "output_fields": ["max_output_tokens"]
    }
  ],
  "models": [
    {
      "key": "gpt-sol-primary",
      "candidates": ["gpt-5.6-sol", "gpt-5.6", "gpt-5.5"],
      "patterns": ["^gpt-[0-9.]+-sol$"],
      "limits_by_model": {
        "gpt-5.6-sol": {
          "maxInputTokens": 1050000,
          "maxOutputTokens": 128000,
          "sources": {
            "maxInputTokens": "https://developers.openai.com/api/docs/models/gpt-5.6-sol",
            "maxOutputTokens": "https://developers.openai.com/api/docs/models/gpt-5.6-sol"
          }
        },
        "gpt-5.6": {
          "maxInputTokens": 1050000,
          "maxOutputTokens": 128000,
          "sources": {
            "maxInputTokens": "https://developers.openai.com/api/docs/models/gpt-5.6-sol",
            "maxOutputTokens": "https://developers.openai.com/api/docs/models/gpt-5.6-sol"
          }
        }
      },
      "workbuddy": {
        "supportsToolCall": true,
        "supportsImages": true,
        "supportsReasoning": true,
        "useCustomProtocol": true,
        "onlyReasoning": true,
        "reasoning": {
          "defaultEffort": "high",
          "supportedEfforts": ["medium", "high", "xhigh", "max"],
          "canDisableThinking": false
        }
      }
    },
    {
      "key": "gpt-sol-fast",
      "candidates": ["gpt-5.6-sol-fast", "gpt-5.6-fast", "gpt-5.5-fast"],
      "patterns": ["^gpt-[0-9.]+(?:-sol)?-fast$"],
      "optional": true,
      "limits_by_model": {
        "gpt-5.6-sol-fast": {
          "maxInputTokens": 1050000,
          "maxOutputTokens": 128000,
          "sources": {
            "maxInputTokens": "https://developers.openai.com/api/docs/models/gpt-5.6-sol",
            "maxOutputTokens": "https://developers.openai.com/api/docs/models/gpt-5.6-sol"
          }
        },
        "gpt-5.6-fast": {
          "maxInputTokens": 1050000,
          "maxOutputTokens": 128000,
          "sources": {
            "maxInputTokens": "https://developers.openai.com/api/docs/models/gpt-5.6-sol",
            "maxOutputTokens": "https://developers.openai.com/api/docs/models/gpt-5.6-sol"
          }
        }
      },
      "workbuddy": {
        "supportsToolCall": true,
        "supportsImages": true,
        "supportsReasoning": true,
        "useCustomProtocol": true,
        "onlyReasoning": true,
        "reasoning": {
          "defaultEffort": "high",
          "supportedEfforts": ["medium", "high", "xhigh", "max"],
          "canDisableThinking": false
        }
      }
    }
  ]
}
